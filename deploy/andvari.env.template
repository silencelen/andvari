# andvari server environment — reference.
#
# Do not fill this in by hand: `andvari setup` writes andvari.env for you (origin, kind, sign-up mode,
# secrets, mail, and operator recovery when you choose it) and refuses to overwrite an existing one.
# As root, in the folder that holds docker-compose.yml (docs/self-hosting.md, "Install"):
#   mkdir -m 700 data
#   docker run --rm --log-driver none -v "$PWD/data:/data" ghcr.io/silencelen/andvari-server:<version> \
#       setup --env-file /data/andvari.env --origin https://vault.example.org
#   mv data/andvari.env andvari.env
# Setup writes the database and this file into ./data, the folder docker-compose.yml mounts at /data,
# as the container's user (uid 10001), mode 0600; `mv` keeps that owner and mode. The setup link it
# prints is a secret (whoever opens it first becomes the operator): --log-driver none keeps it out of
# Docker's logs.
# This file lists every variable the server reads (spec 03 §1.1, §14.4), apart from the three of its
# test mode, so an operator can see what setup chose. Compose reads andvari.env when it makes the
# server's container: after an edit, `chown 10001:10001 andvari.env && chmod 600 andvari.env`, then
# `docker compose up -d` (a `docker compose restart` keeps the old settings). `andvari admin signup …`
# is the only way to loosen sign-up or raise the cap (the operator panel can only tighten).

# ---- container paths (the image sets these; keep them unless you know why) ----
ANDVARI_HOST=0.0.0.0
ANDVARI_PORT=8080
ANDVARI_DB=/data/andvari.db
ANDVARI_BLOB_DIR=/data/blobs
ANDVARI_WEB_DIR=/opt/andvari/web
# ANDVARI_DOWNLOADS_DIR=/data/downloads

# ---- identity of the instance ----
# The instance's one origin: https:// + a domain name (no path; a port only when it is not 443).
# Plain http only for http://localhost and http://127.0.0.1 during development.
ANDVARI_CANONICAL_ORIGIN=
# public (age confirmation for everyone, invitations by the operator only, no operator recovery)
# or private (the default).
ANDVARI_INSTANCE_KIND=private
# Decorative label only; the signed name is the instance card's.
ANDVARI_INSTANCE_NAME=
# Where the apps link "run your own server" (default <origin>/selfhost, this guide on your own server).
# ANDVARI_SELFHOST_DOCS_URL=
# Mandatory 1 for an https origin.
ANDVARI_FORCE_HSTS=1

# ---- sign-up (spec 03 §14.4) ----
# open (email-verified sign-up plus links; needs mail), links (register links only), closed.
ANDVARI_SIGNUP_MODE=links
ANDVARI_SIGNUP_CAP=200
ANDVARI_SIGNUP_DAILY_MAX=25
# 32 random bytes, base64url (setup generates it).
ANDVARI_SIGNUP_SECRET=
# Leading zero bits of the optional sign-up proof of work; 0 = off.
ANDVARI_SIGNUP_POW_BITS=0
# A file of refused email domains, one per line.
# ANDVARI_SIGNUP_BLOCKLIST=/data/blocked-domains.txt
ANDVARI_REQUIRE_AGE_CONFIRM=0
# Who may create register links on a private instance: members or operator.
# ANDVARI_REGISTER_LINKS=members

# ---- per-account quotas (defaults; the operator overrides per account) ----
# ANDVARI_QUOTA_ACCOUNT_BYTES=104857600
# ANDVARI_QUOTA_ITEMS=5000
# ANDVARI_QUOTA_OWNED_SHARED_VAULTS=50
# ANDVARI_QUOTA_OPEN_LINKS=20

# ---- secrets ----
# Fake prelogin salts (32 random bytes, base64url; setup generates it).
ANDVARI_ENUM_SECRET=

# ---- operator recovery (private instances only; setup's recovery-key ceremony fills these) ----
# ANDVARI_RECOVERY_PUBKEY=
# ANDVARI_RECOVERY_FINGERPRINT=

# ---- mail (spec 03 §14.5): Microsoft Graph app-only, or SMTP ----
# ANDVARI_GRAPH_TENANT=
# ANDVARI_GRAPH_CLIENT_ID=
# ANDVARI_GRAPH_CLIENT_SECRET=
# ANDVARI_GRAPH_SENDER=
# ANDVARI_SMTP_HOST=
# ANDVARI_SMTP_PORT=587
# ANDVARI_SMTP_USER=
# ANDVARI_SMTP_PASS=
# ANDVARI_SMTP_FROM=

# ---- sessions, policy floors, limits ----
ANDVARI_TOTP_REQUIRED=0
ANDVARI_OFFLINE_CACHE_ALLOWED=1
# ANDVARI_LOGIN_RATE_PER_MIN=5
# ANDVARI_PUSH_RATE_PER_MIN=120
# ANDVARI_ITEM_MAX_BYTES=2097152
# ANDVARI_MIN_KDF_MEM=67108864
# ANDVARI_MIN_KDF_OPS=3
# ANDVARI_UPLOAD_MAX_CONCURRENT=4
# ANDVARI_REQUEST_READ_TIMEOUT_S=0
# ANDVARI_RESPONSE_WRITE_TIMEOUT_S=0
# ANDVARI_VAULT_GRACE_DAYS=7
# ANDVARI_JANITOR_DRYRUN=0

# ---- the front in front of the server (spec 03 §8) ----
# Peers allowed to name the client IP in a forwarded header. Loopback by default; a host proxy that
# reaches the container through the Docker bridge appears as the bridge gateway, which you name here.
# ANDVARI_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# ANDVARI_TRUSTED_IP_HEADERS=X-Forwarded-For

# A wrong value of a number, a switch or a choice stops the start in any case. With 1, an unknown
# ANDVARI_* name (a typo) and a blank number, switch or choice stop it too; without it, they are only
# warned about in the log and a blank one takes its default. Setup writes this line.
ANDVARI_STRICT_ENV=1
