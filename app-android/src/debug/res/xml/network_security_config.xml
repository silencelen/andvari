<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-VARIANT ONLY (audit F36). AGP overlays this file over src/main's for the debug variant,
  so it never reaches a release APK — verify with `aapt2 dump xmltree` on the release build, or
  trust NetworkSecurityConfigTest, which pins both halves off these two source files.

  It adds exactly one host to the shipped policy: 10.0.2.2, the Android emulator's alias for the
  developer machine, so a dev can point the app at a server running on their own laptop. That is
  a development affordance with production reach if it ships — 10.0.2.2 is an ordinary routable
  RFC1918 address on a real device — which is precisely why it lives here and not in src/main.

  Keep 127.0.0.1 listed: a variant resource REPLACES the main one wholesale rather than merging
  with it, so anything dropped here is dropped from the debug build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
