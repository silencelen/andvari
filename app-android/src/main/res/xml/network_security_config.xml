<?xml version="1.0" encoding="utf-8"?>
<!--
  SHIPPED config. The public default server is HTTPS; cleartext is permitted ONLY to loopback,
  for on-device localhost self-hosting — nothing else.

  The emulator host alias 10.0.2.2 used to be listed here too, and this directory has no debug
  overlay, so every release APK carved that address out of the app's otherwise total cleartext
  ban (audit F36). On a real phone 10.0.2.2 is not an emulator anything: it is an ordinary
  reachable address inside 10.0.0.0/8, one of the most common home and office LAN ranges — so a
  server at (or made to look like it is at) that one address could take sign-in traffic, bearer
  tokens and the derived authKey in plaintext, while every other LAN address was correctly
  refused. It now lives in src/debug/res/xml/, which AGP merges into the debug variant ONLY.

  Self-hosters serving over plain http on a LAN should front their server with HTTPS (reverse
  proxy / tailscale serve / cloudflared) rather than widening this config: OkHttp refuses a
  banned host with UnknownServiceException, which the app reports as HouseholdCopy.CLEARTEXT_BLOCKED.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
